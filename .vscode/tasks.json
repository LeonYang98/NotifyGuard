{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动虚拟手机（Pixel 7）",
      "type": "process",
      "command": "${env:LOCALAPPDATA}\\Android\\Sdk\\emulator\\emulator.exe",
      "args": ["-avd","Pixel_7_API36"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "安装并启动 App（模拟器）",
      "type": "shell",
      "command": ".vscode\\run-app.cmd",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    }
  ]
}
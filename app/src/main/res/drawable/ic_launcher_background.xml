    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        整块统一为原先左半边那支玉绿渐变：左上 -> 右下。
        原来右侧那道更深的墨绿弧已经去掉，底色现在只有这一层。
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#23996E" />
                <item android:offset="1.0" android:color="#0E5B42" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
